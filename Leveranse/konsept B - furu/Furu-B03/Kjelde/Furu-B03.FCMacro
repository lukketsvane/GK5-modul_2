V = A.Vector
def com(sh):
    try:
        return sh.CenterOfMass
    except AttributeError:
        sols = sh.Solids
        tot = sum(s.Volume for s in sols)
        return sum((s.CenterOfMass*s.Volume for s in sols), V())*(1.0/tot)

pi = math.pi
sin, cos, sqrt, rad = math.sin, math.cos, math.sqrt, math.radians
macro = next((p for p in sys.argv if str(p).lower().endswith(".fcmacro")),
             globals().get("__file__", "Furu-B03.FCMacro"))
